@model LoginViewModel
@{
    ViewData["Title"] = "Iniciar sesión";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>Modulo5 — Iniciar sesión</title>
</head>
<body>
    <h1>Iniciar sesión</h1>

    <div asp-validation-summary="ModelOnly" class="mensaje-error"></div>

    <form asp-controller="Account" asp-action="Login" method="post">
        @Html.AntiForgeryToken()

        <div>
            <label asp-for="Usuario"></label>
            <input asp-for="Usuario" autofocus />
            <span asp-validation-for="Usuario" class="mensaje-error"></span>
        </div>

        <div>
            <label asp-for="Password"></label>
            <input asp-for="Password" />
            <span asp-validation-for="Password" class="mensaje-error"></span>
        </div>

        <button type="submit">Ingresar</button>
    </form>
</body>
</html>
