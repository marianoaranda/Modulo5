@model ArticuloCreateViewModel
@{
    ViewData["Title"] = "Nuevo artículo";
}

<p><a href="/Home">Volver a Home</a></p>

<h1>Nuevo artículo</h1>

<div asp-validation-summary="ModelOnly" class="mensaje-error"></div>

<form asp-controller="Articulos" asp-action="Create" method="post">
    @Html.AntiForgeryToken()

    <div>
        <label asp-for="Codigo"></label>
        <input asp-for="Codigo" />
        <span asp-validation-for="Codigo" class="mensaje-error"></span>
    </div>

    <div>
        <label asp-for="Descripcion"></label>
        <input asp-for="Descripcion" />
        <span asp-validation-for="Descripcion" class="mensaje-error"></span>
    </div>

    <div>
        <label asp-for="PrecioCosto"></label>
        <input asp-for="PrecioCosto" type="number" step="0.01" min="0" />
        <span asp-validation-for="PrecioCosto" class="mensaje-error"></span>
    </div>

    <div>
        <label asp-for="Margen"></label>
        <input asp-for="Margen" type="number" step="0.01" min="0" />
        <span asp-validation-for="Margen" class="mensaje-error"></span>
    </div>

    <div>
        <label asp-for="StockMinimo"></label>
        <input asp-for="StockMinimo" type="number" min="0" />
        <span asp-validation-for="StockMinimo" class="mensaje-error"></span>
    </div>

    <div>
        <label asp-for="PuntoPedido"></label>
        <input asp-for="PuntoPedido" type="number" min="0" />
        <span asp-validation-for="PuntoPedido" class="mensaje-error"></span>
    </div>

    <div>
        <label asp-for="StockIdeal"></label>
        <input asp-for="StockIdeal" type="number" min="0" />
        <span asp-validation-for="StockIdeal" class="mensaje-error"></span>
    </div>

    <button type="submit">Crear</button>
    <a href="/Articulos">Cancelar</a>
</form>
