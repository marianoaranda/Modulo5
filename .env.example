# Copiá este archivo a .env (gitignoreado) y completá con valores reales de desarrollo.
# NUNCA commitees el .env real ni reutilices estos valores fuera de un entorno local de
# desarrollo/prueba (mitigación riesgo #2 del threat model de FEAT-002).

# Contraseña de la cuenta sa de SQL Server dentro del contenedor `db`.
# Requisito de complejidad de SQL Server: mínimo 8 caracteres, y al menos 3 de estas 4
# categorías: mayúsculas, minúsculas, dígitos, símbolos.
SA_PASSWORD=changeme-local-only

# Clave de firma de los JWT que emite Modulo5.Api dentro de este entorno Docker.
JWT_SIGNING_KEY=changeme-local-only
